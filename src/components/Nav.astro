---
import { person } from '../data/profile';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
	{ label: 'About', href: '/#about' },
	{ label: 'Experience', href: '/#experience' },
	{ label: 'Speaking', href: '/#speaking' },
	{ label: 'Books', href: '/#books' },
	{ label: 'Writing', href: '/#writing' },
	{ label: 'Contact', href: '/#contact' },
];
---

<header class="site-header">
	<nav class="wrapper bar" aria-label="Main">
		<a href="/" class="brand">
			<span class="brand-mark" aria-hidden="true">KK</span>
			<span class="brand-name">{person.name}</span>
		</a>

		<ul class="links" id="nav-links" role="list">
			{
				links.map(({ label, href }) => (
					<li>
						<a href={href}>{label}</a>
					</li>
				))
			}
		</ul>

		<div class="actions">
			<a class="social" href={person.links.linkedin} target="_blank" rel="noopener me">
				<span class="sr-only">LinkedIn</span>
				<Icon icon="linkedin-logo" />
			</a>
			<a class="social" href={person.links.github} target="_blank" rel="noopener me">
				<span class="sr-only">GitHub</span>
				<Icon icon="github-logo" />
			</a>
			<ThemeToggle />
			<button class="menu-button" type="button" aria-expanded="false" aria-controls="nav-links">
				<span class="sr-only">Menu</span>
				<Icon icon="list" />
			</button>
		</div>
	</nav>
</header>

<script>
	const header = document.querySelector<HTMLElement>('.site-header')!;
	const button = header.querySelector<HTMLButtonElement>('.menu-button')!;

	const setOpen = (open: boolean) => {
		button.setAttribute('aria-expanded', String(open));
		header.classList.toggle('is-open', open);
	};

	button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
	header.querySelectorAll('.links a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
	document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

	// Add a border and shadow once the page scrolls.
	const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: saturate(1.4) blur(14px);
		-webkit-backdrop-filter: saturate(1.4) blur(14px);
		border-bottom: 1px solid transparent;
		transition:
			border-color var(--theme-transition),
			box-shadow var(--theme-transition);
	}

	.site-header.is-scrolled {
		border-color: var(--line);
		box-shadow: var(--shadow-sm);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 4.25rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-md);
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 0.6rem;
		background: var(--ink);
		color: var(--bg);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
	}

	.links {
		display: none;
		margin: 0;
	}

	.links a {
		display: block;
		padding: 0.5rem 0.75rem;
		border-radius: 999rem;
		color: var(--ink-2);
		font-size: var(--text-sm);
		font-weight: 500;
		text-decoration: none;
		transition:
			color var(--theme-transition),
			background-color var(--theme-transition);
	}

	.links a:hover {
		color: var(--ink);
		background: var(--surface-2);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.social {
		display: none;
		padding: 0.5rem;
		color: var(--ink-3);
		font-size: 1.15rem;
		transition: color var(--theme-transition);
	}

	.social:hover {
		color: var(--accent);
	}

	.menu-button {
		display: flex;
		margin-left: 0.5rem;
		padding: 0.5rem;
		border: 1px solid var(--line);
		border-radius: 0.6rem;
		background: var(--surface);
		color: var(--ink);
		font-size: 1.2rem;
		cursor: pointer;
	}

	/* Mobile: links drop down below the bar. Without JS, show them inline. */
	:global(html:not(.js)) .links {
		display: flex;
		flex-wrap: wrap;
	}

	:global(html:not(.js)) .menu-button {
		display: none;
	}

	@media (max-width: 59.99em) {
		.is-open .links {
			display: flex;
			flex-direction: column;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			padding: 0.75rem clamp(1.25rem, 4vw, 2.5rem) 1.25rem;
			background: var(--bg);
			border-bottom: 1px solid var(--line);
			box-shadow: var(--shadow-md);
		}

		.is-open .links a {
			padding: 0.8rem 0.5rem;
			font-size: var(--text-md);
			border-radius: 0.5rem;
		}
	}

	@media (min-width: 60em) {
		.links,
		:global(html:not(.js)) .links {
			display: flex;
			gap: 0.15rem;
		}

		.social {
			display: flex;
		}

		.menu-button {
			display: none;
		}
	}
</style>
