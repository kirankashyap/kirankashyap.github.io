---
import '../styles/global.css';
import { SITE_URL, keywords, person } from '../data/profile';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	image?: string | undefined;
	type?: 'website' | 'profile' | 'book' | undefined;
	jsonLd?: object | undefined;
	noindex?: boolean | undefined;
}

const {
	title = `${person.name} | Technical Program Manager, Product Owner & Agile Coach`,
	description = `${person.name} is a technical program manager, product owner, agile coach and certified SAFe Program Consultant (SPC) in Bengaluru with 13 years in software. Senior Agile Coach at Amadeus, author of books on agile metrics and TDD, and conference speaker.`,
	image = '/og-kiran-kashyap.jpg',
	type = 'profile',
	jsonLd,
	noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE_URL);
const imageURL = new URL(image, Astro.site ?? SITE_URL);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={person.name} />
<meta name="keywords" content={keywords.join(', ')} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#f7f8fb" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#111318" media="(prefers-color-scheme: dark)" />

<!-- Machine-readable summaries -->
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable profile" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="me" href={person.links.linkedin} />
<link rel="me" href={person.links.github} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={person.name} />
<meta property="og:locale" content="en_IN" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={`${person.name}, ${person.headline}`} />
{type === 'profile' && <meta property="profile:first_name" content={person.givenName} />}
{type === 'profile' && <meta property="profile:last_name" content={person.familyName} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/kiran-kashyap.jpg" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500..700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap"
	rel="stylesheet"
/>

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<script is:inline>
	// Inlined and blocking so the theme applies before first paint.
	(() => {
		const root = document.documentElement;
		root.classList.add('js');
		const stored = localStorage.getItem('theme');
		const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
		root.classList.toggle('theme-dark', stored ? stored === 'dark' : prefersDark);

		// Persist explicit choices made with the theme toggle.
		new MutationObserver(() => {
			if (root.dataset.themeChosen) {
				localStorage.setItem('theme', root.classList.contains('theme-dark') ? 'dark' : 'light');
			}
		}).observe(root, { attributes: true, attributeFilter: ['class'] });
	})();
</script>
