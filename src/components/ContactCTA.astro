---
import { person } from '../data/profile';
import Icon from './Icon.astro';
---

<section id="contact" class="contact" aria-labelledby="contact-title">
	<div class="wrapper">
		<div class="panel reveal">
			<div class="stack copy">
				<p class="eyebrow">Contact</p>
				<h2 id="contact-title">Let's talk.</h2>
				<p>
					Write to me about technical program management, product ownership or agile coaching work,
					speaking at your event, or using AI in delivery teams. Email is the fastest way to reach me.
				</p>
			</div>
			<div class="ctas">
				<a class="btn btn-primary" href={`mailto:${person.email}`}>
					<Icon icon="envelope" />
					{person.email}
				</a>
				<a class="btn" href={person.links.linkedin} target="_blank" rel="noopener me">
					<Icon icon="linkedin-logo" />
					Connect on LinkedIn
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		padding-block: clamp(3rem, 6vw, 5rem) clamp(4rem, 8vw, 7rem);
	}

	.panel {
		position: relative;
		display: grid;
		gap: 2.5rem;
		padding: clamp(2rem, 6vw, 4.5rem);
		border-radius: var(--radius-lg);
		background:
			radial-gradient(120% 140% at 100% 0%, #2a3a7a 0%, transparent 55%),
			#0c1226;
		color: #b6bcd2;
		overflow: hidden;
		box-shadow: var(--shadow-lg);
	}

	.panel::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
		background-size: 22px 22px;
		mask-image: linear-gradient(to left, black, transparent 70%);
		pointer-events: none;
	}

	.copy {
		gap: 1rem;
		max-width: 38rem;
		position: relative;
		z-index: 1;
	}

	.eyebrow {
		color: #ffb547;
	}

	h2 {
		color: #eef0f8;
		font-size: var(--text-3xl);
	}

	.ctas {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn {
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.18);
		color: #eef0f8;
	}

	.btn-primary {
		background: #ffb547;
		border-color: #ffb547;
		color: #1a1204;
	}

	@media (min-width: 56em) {
		.panel {
			grid-template-columns: 1fr auto;
			align-items: end;
		}

		.ctas {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
