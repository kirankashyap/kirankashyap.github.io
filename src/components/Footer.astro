---
import { person } from '../data/profile';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrapper inner">
		<div class="stack about">
			<p class="name">{person.name}</p>
			<p>
				{person.headline}. {person.currentRole} at {person.currentEmployer}, based in {person.location.city},{' '}
				{person.location.country}.
			</p>
			<p class="copy">&copy; {currentYear} {person.name}</p>
		</div>
		<nav aria-label="Elsewhere" class="cols">
			<ul role="list">
				<li><a href={`mailto:${person.email}`}>Email</a></li>
				<li><a href={person.links.linkedin} target="_blank" rel="noopener me">LinkedIn</a></li>
				<li><a href={person.links.github} target="_blank" rel="noopener me">GitHub</a></li>
			</ul>
			<ul role="list">
				<li><a href={person.links.substack} target="_blank" rel="noopener me">Substack</a></li>
				<li><a href={person.links.medium} target="_blank" rel="noopener me">Medium</a></li>
				<li><a href={person.links.leanpub} target="_blank" rel="noopener me">Leanpub</a></li>
			</ul>
			<ul role="list">
				<li><a href="/llms.txt">llms.txt</a></li>
				<li><a href="/sitemap.xml">Sitemap</a></li>
			</ul>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		padding-block: 3.5rem;
		border-top: 1px solid var(--line);
		font-size: var(--text-sm);
		color: var(--ink-3);
	}

	.inner {
		display: grid;
		gap: 2.5rem;
	}

	.about {
		gap: 0.5rem;
		max-width: 34rem;
	}

	.name {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--ink);
	}

	.copy {
		margin-top: 0.5rem;
	}

	.cols {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 3.5rem;
	}

	.cols ul {
		display: grid;
		align-content: start;
		gap: 0.5rem;
	}

	a {
		color: var(--ink-2);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	a:hover {
		color: var(--accent);
	}

	@media (min-width: 50em) {
		.inner {
			grid-template-columns: 1fr auto;
			align-items: start;
		}
	}
</style>
