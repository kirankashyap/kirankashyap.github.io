---
import Icon from './Icon.astro';
---

<theme-toggle>
	<button type="button" aria-pressed="false">
		<span class="sr-only">Dark theme</span>
		<span class="icon light"><Icon icon="sun" /></span>
		<span class="icon dark"><Icon icon="moon-stars" /></span>
	</button>
</theme-toggle>

<style>
	button {
		position: relative;
		display: flex;
		border: 1px solid var(--line);
		border-radius: 999rem;
		padding: 2px;
		background-color: var(--surface);
		cursor: pointer;
	}

	.icon {
		z-index: 1;
		position: relative;
		display: flex;
		padding: 0.4rem;
		width: 1.85rem;
		height: 1.85rem;
		font-size: 1rem;
		color: var(--ink-3);
	}

	.icon.light::before {
		content: '';
		z-index: -1;
		position: absolute;
		inset: 0;
		background-color: var(--accent);
		border-radius: 999rem;
	}

	:global(.theme-dark) .icon.light::before {
		transform: translateX(100%);
	}

	:global(.theme-dark) .icon.dark,
	:global(html:not(.theme-dark)) .icon.light {
		color: var(--on-accent);
	}

	@media (prefers-reduced-motion: no-preference) {
		.icon,
		.icon.light::before {
			transition:
				transform var(--theme-transition),
				color var(--theme-transition);
		}
	}

	@media (forced-colors: active) {
		.icon.light::before {
			background-color: SelectedItem;
		}
	}
</style>

<script>
	class ThemeToggle extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector('button')!;
			const root = document.documentElement;

			const sync = () => button.setAttribute('aria-pressed', String(root.classList.contains('theme-dark')));

			button.addEventListener('click', () => {
				root.dataset.themeChosen = 'true';
				root.classList.toggle('theme-dark');
				sync();
			});

			sync();
		}
	}
	customElements.define('theme-toggle', ThemeToggle);
</script>
