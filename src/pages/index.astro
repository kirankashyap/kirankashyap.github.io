---
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
	contributions,
	coreSkills,
	credentials,
	experience,
	formatDate,
	formatRange,
	person,
	practices,
	talks,
	talkYear,
	tools,
	writings,
} from '../data/profile';
import { homeGraph } from '../data/schema';

import headshot from '../assets/photos/kiran-kashyap-headshot.png';
import pmFootprintsPhoto from '../assets/photos/pm-footprints-bengaluru-2026.jpg';
import icaisePhoto from '../assets/photos/icaise-tokyo-2026.jpg';
import tccPhoto from '../assets/photos/tech-coach-circle-quantum-computing.png';

// Upcoming books first, then newest published.
const books = (await getCollection('books')).sort((a, b) => {
	if (a.data.status !== b.data.status) return a.data.status === 'upcoming' ? -1 : 1;
	return (b.data.publishDate?.valueOf() ?? 0) - (a.data.publishDate?.valueOf() ?? 0);
});
const upcoming = books.filter((b) => b.data.status === 'upcoming');
const published = books.filter((b) => b.data.status === 'published');

const bookCovers = await Promise.all(
	books.map(async (entry) => ({
		entry,
		coverUrl: (await getImage({ src: entry.data.cover, width: 600, format: 'jpg' })).src,
	})),
);

const featuredTalks = talks.filter((t) => t.featured);
const pastTalks = talks.filter((t) => !t.featured);
const talkPhotos = [
	{ src: pmFootprintsPhoto, alt: 'Kiran Kashyap on stage at PMI Bangalore Chapter PM Footprints, Radisson Blu Bengaluru' },
	{ src: icaisePhoto, alt: 'Kiran Kashyap presenting at ICAISE 2026 in Tokyo' },
	{ src: tccPhoto, alt: 'Kiran Kashyap presenting "WTH is Quantum Computing!!!" at Tech Coach Circle' },
];

const current = experience[0];
const stats = [
	{ value: `${person.yearsInTech}`, label: 'years in software' },
	{ value: `${person.yearsWithAgileTeams}`, label: 'years with agile teams' },
	{ value: `${published.length}+${upcoming.length}`, label: 'books, published + upcoming' },
	{ value: `${talks.length}`, label: 'conference and community talks' },
];
---

<BaseLayout jsonLd={homeGraph(bookCovers)}>
	<!-- Hero -->
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-bg" aria-hidden="true"></div>
		<div class="wrapper hero-grid">
			<div class="stack hero-copy">
				<p class="eyebrow">
					{current.role} at {current.company} · {person.location.city}, {person.location.country}
				</p>
				<h1 id="hero-title">
					<span class="hero-name">{person.name}</span>
					<span class="hero-roles">
						Technical program manager, <em>product owner</em> and agile coach.
					</span>
				</h1>
				<p class="lede">
					I run programs that cross many teams, turn product strategy into roadmaps teams can deliver,
					and coach teams and leaders on how they work. I also write code, and lately I build the AI
					tools that agile teams use.
				</p>
				<p class="hero-badge">
					<Icon icon="seal-check" /> Certified SAFe Program Consultant (SPC)
				</p>
				<div class="hero-ctas">
					<a class="btn btn-primary" href={`mailto:${person.email}`}>
						<Icon icon="envelope" /> Email me
					</a>
					<a class="btn" href="#experience">See my experience <Icon icon="arrow-right" /></a>
				</div>
			</div>

			<div class="hero-media">
				<div class="portrait">
					<Picture
						src={headshot}
						alt={`${person.name}, ${person.headline}`}
						widths={[320, 480, 640, 800]}
						sizes="(min-width: 60em) 420px, 80vw"
						formats={['avif', 'webp']}
						fallbackFormat="jpg"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
				<a class="chip chip-talk" href="#speaking">
					<span class="chip-dot" aria-hidden="true"></span>
					<span>
						<strong>Latest talk</strong>
						PMI Bangalore, {formatDate(featuredTalks[0].date)}
					</span>
				</a>
				<a class="chip chip-book" href="#books">
					<Icon icon="book-open" />
					<span>
						<strong>New book</strong>
						Quantum computing, coming soon
					</span>
				</a>
			</div>
		</div>

		<div class="wrapper">
			<dl class="stats">
				{
					stats.map((s) => (
						<div class="stat">
							<dt>{s.label}</dt>
							<dd>{s.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- About -->
	<section id="about" class="section" aria-labelledby="about-title">
		<div class="wrapper about-grid">
			<div class="stack about-copy reveal">
				<p class="eyebrow">About</p>
				<h2 id="about-title" class="section-title">Thirteen years of shipping software with other people.</h2>
				<p>
					I started in 2013 as a PEGA developer at Cognizant, moved into production support, and then
					volunteered as Scrum Master for a SAFe pilot team. I have worked with agile teams ever since: at
					Societe Generale, at Lowe's, at two startups, and now as a Senior Agile Coach at Amadeus.
				</p>
				<p>
					Most of that time I have been the person who keeps delivery moving across teams. At Lowe's I
					helped plan and run a multi-team cloud transformation. At ConverseNow I owned release management
					for seven teams on Google Cloud. At Tailorbird, where I joined early, I set up cross-team planning,
					delivery forecasting and the test strategy, and ran the QA team across India and Latin America.
				</p>
				<p>
					I still build things. At Amadeus I created an AI tool for Scrum Masters, product owners, product
					managers and release train engineers, and teams across the company now reuse the agents, skills
					and prompts I wrote. I have co-written books on TDD and agile metrics, and I contribute to open
					source projects such as Stryker and GitHub's Copilot SDK.
				</p>
				<p>
					Away from work I play badminton, snooker and pickleball, and I read Swami Vivekananda.
				</p>
			</div>

			<aside class="glance reveal" aria-labelledby="glance-title">
				<h3 id="glance-title">At a glance</h3>
				<dl>
					<div>
						<dt>Roles</dt>
						<dd>Technical Program Manager, Product Owner / Product Manager, Agile Coach, SAFe Program Consultant (SPC)</dd>
					</div>
					<div>
						<dt>Now</dt>
						<dd>{current.role}, {current.company} (since {formatDate(current.start)})</dd>
					</div>
					<div>
						<dt>Based in</dt>
						<dd>{person.location.city}, {person.location.country}</dd>
					</div>
					<div>
						<dt>Experience</dt>
						<dd>{person.yearsInTech} years in IT, {person.yearsWithAgileTeams} with agile teams</dd>
					</div>
					<div>
						<dt>Certifications</dt>
						<dd>{credentials.map((c) => c.short).join(', ')}</dd>
					</div>
					<div>
						<dt>Industries</dt>
						<dd>Travel tech, retail, banking, proptech, conversational AI, IT services</dd>
					</div>
					<div>
						<dt>Contact</dt>
						<dd><a href={`mailto:${person.email}`}>{person.email}</a></dd>
					</div>
				</dl>
			</aside>
		</div>
	</section>

	<!-- What I do -->
	<section id="what-i-do" class="section" aria-labelledby="practice-title">
		<div class="wrapper">
			<header class="section-head reveal">
				<p class="eyebrow">What I do</p>
				<h2 id="practice-title" class="section-title">Programs, products and the people who build them.</h2>
				<p class="section-lede">
					Companies have brought me in to run programs, own products and coach teams. At startups I have
					usually done more than one of these at once.
				</p>
			</header>

			<ul class="practice-grid" role="list">
				{
					practices.map((p, i) => (
						<li class="practice reveal" id={p.id} style={`transition-delay:${i * 70}ms`}>
							<span class="practice-icon">
								<Icon
									icon={(['kanban', 'rocket-launch', 'users', 'sparkle'] as const)[i]}
									size="1.4rem"
								/>
							</span>
							<h3>{p.title}</h3>
							<p>{p.summary}</p>
							<ul role="list" class="evidence">
								{p.evidence.map((e) => <li>{e}</li>)}
							</ul>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Experience -->
	<section id="experience" class="section" aria-labelledby="experience-title">
		<div class="wrapper">
			<header class="section-head reveal">
				<p class="eyebrow">Experience</p>
				<h2 id="experience-title" class="section-title">Where I have worked.</h2>
			</header>

			<ol class="timeline" role="list">
				{
					experience.map((job) => (
						<li class:list={['job reveal', { current: !job.end }]}>
							<div class="job-meta">
								<p class="job-dates">
									<time datetime={job.start}>{formatDate(job.start)}</time> –{' '}
									{job.end ? <time datetime={job.end}>{formatDate(job.end)}</time> : 'Present'}
								</p>
								{job.note && (
									<span class="tag tag-startup">
										<Icon icon="rocket-launch" /> {job.note}
									</span>
								)}
								{!job.end && <span class="tag tag-accent">Current</span>}
							</div>
							<div class="job-body">
								<h3>
									{job.role} <span class="at">at</span> {job.company}
								</h3>
								<ul role="list">
									{job.highlights.map((h) => <li>{h}</li>)}
								</ul>
							</div>
						</li>
					))
				}
			</ol>

			<div class="skills-grid">
				<div class="skills-card reveal">
					<h3><Icon icon="seal-check" /> Certifications</h3>
					<ul role="list" class="cert-list">
						{
							credentials.map((c) => (
								<li>
									<span class="cert-short">{c.short}</span>
									<span>
										{c.name}
										<small>{c.issuer}</small>
									</span>
								</li>
							))
						}
					</ul>
				</div>
				<div class="skills-card reveal">
					<h3><Icon icon="users" /> Core skills</h3>
					<ul role="list" class="tags">
						{coreSkills.map((s) => <li class="tag">{s}</li>)}
					</ul>
					<h3 class="tools-title"><Icon icon="terminal-window" /> Tools and tech</h3>
					<ul role="list" class="tags">
						{tools.map((s) => <li class="tag">{s}</li>)}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Speaking -->
	<section id="speaking" class="section" aria-labelledby="speaking-title">
		<div class="wrapper">
			<header class="section-head reveal">
				<p class="eyebrow">Speaking</p>
				<h2 id="speaking-title" class="section-title">Talks, from Montreal to Tokyo.</h2>
				<p class="section-lede">
					I like demo-based, interactive talks. Recent ones have been about AI in delivery and quantum
					computing; earlier ones covered agile, DevOps and engineering practice.
				</p>
			</header>

			<ul class="talk-grid" role="list">
				{
					featuredTalks.map((talk, i) => (
						<li class:list={['talk reveal', { 'talk-lead': i === 0 }]}>
							<article>
								<div class="talk-media">
									<Picture
										src={talkPhotos[i].src}
										alt={talkPhotos[i].alt}
										widths={i === 0 ? [480, 800, 1200] : [400, 600, 800]}
										sizes={i === 0 ? '(min-width: 60em) 720px, 100vw' : '(min-width: 60em) 380px, 100vw'}
										formats={['avif', 'webp']}
										fallbackFormat="jpg"
									/>
								</div>
								<div class="talk-body">
									<p class="talk-meta">
										{talk.date && (
											<span>
												<Icon icon="calendar" />{' '}
												<time datetime={talk.date}>
													{talk.endDate
														? `${formatDate(talk.date).split(' ')[0]}–${formatDate(talk.endDate)}`
														: formatDate(talk.date)}
												</time>
											</span>
										)}
										{talk.location && (
											<span>
												<Icon icon="map-pin" /> {talk.location}
											</span>
										)}
									</p>
									<h3>{talk.title === talk.event ? talk.event : talk.title}</h3>
									<p class="talk-event">
										{talk.title !== talk.event && talk.event}
										{talk.organizer && `, ${talk.organizer}`}
										{talk.venue && <span class="talk-venue">{talk.venue}</span>}
									</p>
									{talk.description && <p>{talk.description}</p>}
									{talk.url && (
										<a class="text-link" href={talk.url} target="_blank" rel="noopener">
											Event page <Icon icon="arrow-up-right" />
										</a>
									)}
								</div>
							</article>
						</li>
					))
				}
			</ul>

			<div class="past-talks reveal">
				<div class="past-head">
					<h3>Earlier talks</h3>
					<a class="btn" href={person.links.youtube} target="_blank" rel="noopener">
						<Icon icon="youtube-logo" /> Recordings on YouTube
					</a>
				</div>
				<ul role="list">
					{
						pastTalks.map((talk) => (
							<li>
								<span class="past-year">{talkYear(talk) || 'Earlier'}</span>
								<span class="past-name">{talk.title}</span>
								<span class="past-loc">{talk.location}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<!-- Books -->
	<section id="books" class="section" aria-labelledby="books-title">
		<div class="wrapper">
			<header class="section-head reveal">
				<p class="eyebrow">Books</p>
				<h2 id="books-title" class="section-title">Books I have co-written.</h2>
				<p class="section-lede">
					Practical books for engineers and agile teams, written with Vivek Ganesan, Kamal Raj Sekar and
					Guru Thimmapuram.
				</p>
			</header>

			{
				upcoming.map((book) => (
					<article class="book-feature reveal">
						<a class="book-feature-cover" href={`/books/${book.id}/`} tabindex="-1" aria-hidden="true">
							<Picture
								src={book.data.cover}
								alt=""
								widths={[300, 450, 600]}
								sizes="(min-width: 50em) 320px, 60vw"
								formats={['avif', 'webp']}
						fallbackFormat="jpg"
							/>
						</a>
						<div class="stack book-feature-copy">
							<span class="tag tag-accent">Coming soon</span>
							<h3>
								<a href={`/books/${book.id}/`}>{book.data.title}</a>
							</h3>
							<p class="book-sub">{book.data.subtitle}</p>
							<p>{book.data.description}</p>
							<p class="book-authors">By {book.data.authors.join(', ')}</p>
							<a class="btn" href={`/books/${book.id}/`}>
								About the book <Icon icon="arrow-right" />
							</a>
						</div>
					</article>
				))
			}

			<ul class="book-grid" role="list">
				{
					published.map((book, i) => (
						<li class="book reveal" style={`transition-delay:${i * 70}ms`}>
							<a href={`/books/${book.id}/`} class="book-link">
								<div class="book-cover">
									<Picture
										src={book.data.cover}
										alt={book.data.coverAlt}
										widths={[240, 360, 480]}
										sizes="(min-width: 50em) 240px, 50vw"
										formats={['avif', 'webp']}
						fallbackFormat="jpg"
									/>
								</div>
								<div class="book-meta">
									<span class="book-year">{book.data.publishDate?.getFullYear()}</span>
									<h3>{book.data.title}</h3>
									<p>{book.data.subtitle}</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Writing & open source -->
	<section id="writing" class="section" aria-labelledby="writing-title">
		<div class="wrapper">
			<header class="section-head reveal">
				<p class="eyebrow">Writing and open source</p>
				<h2 id="writing-title" class="section-title">Notes from the work.</h2>
				<p class="section-lede">
					I write on <a href={person.links.substack} target="_blank" rel="noopener">Substack</a>{' '}about AI and
					engineering teams, and on <a href={person.links.medium} target="_blank" rel="noopener">Medium</a>{' '}
					about agile practice.
				</p>
			</header>

			<div class="writing-grid">
				<div class="reveal">
					<h3 class="list-title">Articles</h3>
					<ul role="list" class="link-list">
						{
							writings.map((w) => (
								<li>
									<a href={w.href} target="_blank" rel="noopener">
										<span class="link-title">
											{w.title} <Icon icon="arrow-up-right" />
										</span>
										<span class="link-desc">{w.description}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div class="reveal">
					<h3 class="list-title">Open source contributions</h3>
					<ul role="list" class="link-list">
						{
							contributions.map((c) => (
								<li>
									<a href={c.href} target="_blank" rel="noopener">
										<span class="link-title mono">
											{c.title} <Icon icon="arrow-up-right" />
										</span>
										<span class="link-desc">{c.description}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<ContactCTA />
</BaseLayout>

<style>
	/* ---------- Hero ---------- */

	.hero {
		position: relative;
		padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 6vw, 4.5rem);
		isolation: isolate;
	}

	.hero-bg {
		position: absolute;
		inset: -4.25rem 0 0;
		z-index: -1;
		background:
			radial-gradient(60% 55% at 85% 20%, var(--bg-glow), transparent 70%),
			radial-gradient(40% 40% at 10% 90%, var(--brand-soft), transparent 70%);
		overflow: hidden;
		mask-image: linear-gradient(to bottom, black 70%, transparent);
	}

	.hero-bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(var(--line) 1px, transparent 1px),
			linear-gradient(90deg, var(--line) 1px, transparent 1px);
		background-size: 56px 56px;
		opacity: 0.45;
		mask-image: radial-gradient(70% 60% at 70% 30%, black, transparent 75%);
	}

	.hero-grid {
		display: grid;
		gap: 3rem;
		align-items: center;
	}

	.hero-copy {
		gap: 1.5rem;
	}

	h1 {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.hero-name {
		font-size: var(--text-hero);
		letter-spacing: -0.035em;
		line-height: 0.95;
	}

	.hero-roles {
		font-size: var(--text-2xl);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--ink-2);
		max-width: 22ch;
	}

	.hero-roles em {
		font-style: italic;
		padding-right: 0.08em;
		color: var(--accent);
	}

	.lede {
		font-size: var(--text-md);
		max-width: 56ch;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		align-self: flex-start;
		padding: 0.45rem 0.9rem;
		border-radius: 999rem;
		border: 1px solid var(--line);
		background: var(--surface);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--ink);
	}

	.hero-badge :global(svg) {
		color: var(--accent);
		font-size: 1.1rem;
	}

	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.hero-media {
		position: relative;
		justify-self: center;
		width: min(100%, 26rem);
		order: -1;
	}

	.portrait {
		position: relative;
		border-radius: 2rem;
		overflow: hidden;
		aspect-ratio: 4 / 5;
		box-shadow: var(--shadow-lg);
		transform: rotate(1.5deg);
		border: 6px solid var(--surface);
	}

	.portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 30%;
	}

	.chip {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.7rem 1rem;
		border-radius: 1rem;
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: var(--shadow-md);
		font-size: var(--text-xs);
		line-height: 1.35;
		color: var(--ink-2);
		text-decoration: none;
		transition: transform 0.25s var(--ease);
	}

	.chip:hover {
		transform: translateY(-3px);
	}

	.chip strong {
		display: block;
		color: var(--ink);
		font-size: var(--text-sm);
	}

	.chip :global(svg) {
		color: var(--accent);
		font-size: 1.3rem;
	}

	.chip-talk {
		left: -1rem;
		bottom: 18%;
	}

	.chip-book {
		right: -1rem;
		top: 8%;
	}

	.chip-dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: #22c55e;
		box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.2);
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		margin-top: clamp(3rem, 6vw, 4.5rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface);
		overflow: hidden;
	}

	.stat {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.25rem;
		padding: 1.25rem 1.5rem;
		border-right: 1px solid var(--line);
